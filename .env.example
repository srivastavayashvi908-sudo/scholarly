# Copy this file to .env and fill in the values. Never commit .env.

# Secret used to sign login tokens. Any long random string works.
JWT_SECRET=change-me-to-a-long-random-string

# LLM used for summaries and "Ask your library".
# Grok (xAI) by default; any OpenAI-compatible API works (Groq, OpenAI, ...).
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4-fast-non-reasoning

# DATABASE_URL is set by docker-compose.yml. Only needed if you run the backend outside Docker:
# DATABASE_URL=postgresql://research:research@localhost:5433/research
